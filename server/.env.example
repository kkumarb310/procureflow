# --- ProcureFlow API environment ---

# Postgres connection string.
# Local:  postgres://postgres:postgres@localhost:5432/procureflow
# Neon:   postgres://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/procureflow

# Set to "true" when using a hosted Postgres that requires SSL (Neon, Render, Supabase).
PGSSL=false

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime.
JWT_EXPIRES_IN=7d

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# e.g. http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173
